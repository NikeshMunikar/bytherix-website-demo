# Copy to .env and fill in your values
# Never commit .env — only .env.example

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=bx_root
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=bytherix
MONGO_USERNAME=bx_user
MONGO_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Connection strings (used by Docker api container) ─────────────────────────
MONGODB_URI=mongodb://bx_user:MONGO_PASSWORD@mongo:27017/bytherix?authSource=bytherix
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# The URL the API is reachable at from a user's browser — used to build
# absolute URLs for uploaded files. In Docker Compose on localhost the
# default below is correct; in production set this to your real API domain.
API_PUBLIC_URL=http://localhost:5000
# Where uploaded files are stored. In Docker this is backed by the
# uploads_data named volume (see docker-compose.yml) — persistent across
# restarts. Outside Docker, defaults to a local ./uploads folder.
UPLOAD_DIR=/app/uploads

# ── eSewa (payments) ────────────────────────────────────────────────────────
# The values below are eSewa's published UAT/sandbox test credentials — safe
# to use for development, but MUST be replaced with real merchant credentials
# (from eSewa's merchant onboarding) and production URLs before accepting
# real payments. See apps/api/src/config/index.ts for the production URLs.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# ── JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bytherix.com

# ── Optional ──────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1