# Always use exact versions for security — no accidental upgrades
save-exact=true

# Prevent hoisting issues in monorepos
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# Lockfile must always be up to date
frozen-lockfile=false

# Store path for CI caching
store-dir=~/.pnpm-store

# .npmrc — minimal settings for yarn
save-exact=true